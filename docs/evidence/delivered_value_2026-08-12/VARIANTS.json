{
 "arm_status": {
  "V5 [OFF]": "RULED OFF 2026-08-13. OWNER: \"don't worry about V5 for now - the XW change addressed the issue and V5 on top would impact the live board a bit too much I think.\" Kept in the menu as MEASURED CONTEXT only; it is not a live option.",
  "flat-14": "OPERATIVE -- the live config and the basis of every 26B conclusion",
  "grace-A": "NOT RULED -- live variant, measurement only",
  "grace-B": "NOT RULED -- live variant, measurement only"
 },
 "grace_cfg": {
  "age_source": "Layer 1 entry_age (100% coverage); the recorded year-18 fallback is used only where entry_age is null, and it never overwrites a real age.",
  "everything_else": "identical to the operative C2 basis: loclin curve, force-majeure slide, window tiers, games weighting, K=15, bars, positions, tails.",
  "grace0_diagnostic": "exponent max(0, k - 1) for everyone -- isolates the universal one-year shift the literal formula embeds, so the conflation is a number and not an argument.",
  "k_convention": "k = season_year - entry_year; k = 1 is a normal draftee's FIRST played season and carries 1.14^-1 on the current basis. k <= 0 discounts at 1.0 (engine convention).",
  "landing_constraint": "AT LANDING THE TWO SIDES CANNOT MOVE APART. The identity gate ties this scorer to price6, which discounts projected seasons through the same disc_factor. A grace on the curve side alone would break that identity and the ruled landing assert with it. If a grace is ever ruled in it must be ruled into disc_factor itself, and both sides re-derive together.",
  "mechanism": "an EXPONENT SHIFT in the existing discount ladder: DF(k) = disc_factor(entry_age, 0.14, max(0, k - G)). It still routes through the engine's own disc_factor callable; only the exponent handed to it moves.",
  "owner_diagnosis": "the flat-from-year-1 fade compresses the hits' peak seasons (year-4 weight 0.5921) while busts score zero under any fade",
  "owner_spec_A": "\"the future season fade only starts after season 1... years 1 and 2 are 100%, then year 3 14% less\" -- for normal-draft-age entrants only (\"19 in their first year. Not mature age players\")",
  "owner_spec_B": "\"normal draft age kids get two seasons of grace, and kids drafted one year older get one\"",
  "provenance": "owner order #334 comment 5275831956 (2026-08-13); readings and the k-mapping fixed in PRESTATEMENT_26BV.md, committed before any variant was computed.",
  "reading_L": "SECONDARY. exponent max(0, k - 1 - G).  grace-A: G = 1 if <= 19 else 0.  grace-B: G = 2 if <= 19, 1 if == 20, else 0.  Gives EVERY entrant one free year at G = 0.",
  "reading_O": "PRIMARY. exponent max(0, k - G_O).  grace-A: G_O = 2 if entry_age <= 19 else 0.  grace-B: G_O = 3 if <= 19, 2 if == 20, else 0.",
  "status": "MEASUREMENT ONLY -- NOT RULED. flat-14 remains the operative basis."
 },
