{
  "hooks": {
    "SessionStart": [
      { "hooks": [ { "type": "command", "command": "$CLAUDE_PROJECT_DIR/.claude/hooks/session-start.sh" } ] }
    ]
  },
  "permissions": {
    "allow": [
      "Bash(curl -sS --cacert /root/.ccr/ca-bundle.crt -X POST https://workbench.md/*)",
      "Bash(curl -sS --cacert /root/.ccr/ca-bundle.crt -X PUT https://workbench.md/*)"
    ]
  }
}
