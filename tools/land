#!/usr/bin/env bash
# tools/land — THE LANDING COMMAND.
#   tools/land lever --spec <act.json>    the lever-landing transaction (PLAN_v6 2a)
#   tools/land round --spec <act.json>    the round-advance transaction  (PLAN_v6 2b)
#
# TWO VERBS, ONE LIBRARY, AND THIS FILE DID NOT GROW A LINE FOR THE SECOND ONE — which is the whole
# argument of 2a.1: "2b becomes a second thin entry point — mirrored script pairs drift".
#
# A three-line wrapper so the command reads the way the plan names it (`land lever`) and so the
# lander is invoked by PATH rather than by remembering a module path at 3am. Everything it does is
# in tools/landing/; this file adds nothing but the name.
exec python3 "$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)/landing/cli.py" "$@"
